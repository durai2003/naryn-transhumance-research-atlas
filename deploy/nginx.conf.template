proxy_cache_path /var/cache/nginx/atlas levels=1:2 keys_zone=atlas_cache:20m max_size=400m inactive=7d use_temp_path=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};
    server_name _;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/json text/plain text/css application/javascript application/wasm;

    client_max_body_size 25m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location = /atlas {
        return 308 /atlas/;
    }

    # Cache content-addressed JSON payloads (the state query is a payload hash).
    location ~ ^/atlas/(network/)?payload\.json$ {
        rewrite ^/atlas/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8765;
        proxy_cache atlas_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 7d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_buffering on;
        add_header X-Atlas-Cache $upstream_cache_status always;
    }

    # Terrain and imagery tiles are immutable for practical browser-map use;
    # cache them at the public edge of the container to avoid repeated Python
    # proxy/file-read work on each Cesium camera refresh.
    location ^~ /atlas/proxy/ {
        proxy_pass http://127.0.0.1:8765/proxy/;
        proxy_http_version 1.1;
        proxy_cache atlas_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 7d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_buffering on;
        add_header X-Atlas-Cache $upstream_cache_status always;
    }

    # Public browser requests to /atlas/* are forwarded to the
    # in-container Cesium asset server, with /atlas stripped.
    location /atlas/ {
        proxy_pass http://127.0.0.1:8765/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_buffering off;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8501/_stcore/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Streamlit UI and its WebSocket endpoint.
    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
    }
}
